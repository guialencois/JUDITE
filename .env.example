# Copie este arquivo para .env.local e preencha. Nunca envie o .env.local ao GitHub.
# As mesmas variáveis vão na Vercel: Settings -> Environment Variables.

# Supabase (públicas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (SECRETA, só servidor): Project Settings -> API Keys -> secret / service_role
SUPABASE_SERVICE_ROLE_KEY=

# Windsor.ai (provedor TEMPORÁRIO de anúncios, só servidor)
WINDSOR_API_KEY=

# Segredo do cron (Vercel envia como "Authorization: Bearer"). Frase longa aleatória.
CRON_SECRET=
# Opcional: para testar a sincronização na mão com o cabeçalho x-cron-secret.
TRAFEGO_CRON_SECRET=
