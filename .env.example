# Copie este arquivo para .env.local e preencha. Nunca envie o .env.local ao GitHub.
# As mesmas variáveis vão na Vercel: Settings -> Environment Variables.

# Supabase (públicas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (SECRETA, só servidor): Project Settings -> API Keys -> secret / service_role
SUPABASE_SERVICE_ROLE_KEY=

# As conexões com Google Ads e Meta são configuradas na própria JUDITE (página Conexões).
# Os tokens ficam criptografados com esta chave (32 bytes em base64). Use o mesmo valor na Vercel.
# Sem ela, a chave é derivada da SUPABASE_SERVICE_ROLE_KEY. Não troque depois de salvar conexões.
JUDITE_CHAVE_CRIPTO=

# Claude API (SECRETA, só servidor): usada pelo Diretor e pelo Creative Studio.
# Onde conseguir: console.anthropic.com -> API Keys. Sem ela, as telas explicam o que falta.
ANTHROPIC_API_KEY=

# Segredo do cron (Vercel envia como "Authorization: Bearer"). Frase longa aleatória.
CRON_SECRET=
# Opcional: para testar a sincronização na mão com o cabeçalho x-cron-secret.
TRAFEGO_CRON_SECRET=
