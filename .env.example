# Copie este arquivo para .env.local e preencha. Nunca envie o .env.local ao GitHub.
# As mesmas variáveis vão na Vercel: Settings -> Environment Variables.

# Supabase (públicas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (SECRETA, só servidor): Project Settings -> API Keys -> secret / service_role
SUPABASE_SERVICE_ROLE_KEY=

# Apps da JUDITE em cada plataforma (SECRETAS, só servidor). Com elas, o dono de cada workspace só clica em
# "Conectar", faz login e escolhe a conta. Passo a passo em docs/CONEXOES-OAUTH.md. Sem uma variável, vale o
# valor salvo por workspace em Conexões -> Opções avançadas.
# Endereço definitivo do site, sem barra no fim (as URLs de retorno do OAuth são montadas a partir dele).
SITE_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Opcional: os 10 números da conta de administrador (MCC) do Google Ads.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
META_APP_ID=
META_APP_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# As conexões com Google Ads e Meta são configuradas na própria JUDITE (página Conexões).
# Os tokens ficam criptografados com esta chave (32 bytes em base64). Use o mesmo valor na Vercel.
# Sem ela, a chave é derivada da SUPABASE_SERVICE_ROLE_KEY. Não troque depois de salvar conexões.
JUDITE_CHAVE_CRIPTO=

# IA do Diretor, do Creative Studio e do rascunho de campanha (SECRETAS, só servidor).
# Sem nenhuma chave, as telas explicam o que falta e o resto funciona.
#
# Google Gemini (plano grátis do AI Studio): aistudio.google.com/apikey -> Criar chave de API.
GEMINI_API_KEY=
# Alternativa paga: Claude API. console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
# Opcional: "gemini" ou "anthropic". Vazio = Gemini se GEMINI_API_KEY existir, senão Anthropic.
IA_PROVEDOR=

# Campaign Manager: deixe VAZIO para o modo simulado (padrão seguro: nada é criado nas plataformas).
# Só coloque 1 quando quiser que a aprovação crie a campanha de verdade (sempre PAUSADA).
JUDITE_PUBLICACAO_REAL=

# Segredo do cron (Vercel envia como "Authorization: Bearer"). Frase longa aleatória.
CRON_SECRET=
# Opcional: para testar a sincronização na mão com o cabeçalho x-cron-secret.
TRAFEGO_CRON_SECRET=

# Ponte com o LUNIKO (opcional). Vazias = nada é enviado. Com as duas preenchidas, a JUDITE avisa o LUNIKO
# de cada mudança de estado de campanha por webhook assinado (contrato em docs/CONTRATO-LUNIKO.md).
LUNIKO_WEBHOOK_URL=
# Segredo compartilhado para a assinatura HMAC (SECRETA, só servidor). Frase longa aleatória, a mesma nos dois lados.
LUNIKO_WEBHOOK_SECRET=
