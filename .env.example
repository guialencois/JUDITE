# Copie este arquivo para .env.local e preencha. Nunca envie o .env.local ao GitHub.
# As mesmas variáveis vão na Vercel: Settings -> Environment Variables.

# Supabase (públicas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (SECRETA, só servidor): Project Settings -> API Keys -> secret / service_role
SUPABASE_SERVICE_ROLE_KEY=

# Criptografia dos tokens das conexões (32 bytes em base64). Veja a página Conexões, passo 0.
JUDITE_CHAVE_CRIPTO=

# Endereço definitivo do site, sem barra no final (ex.: https://judite.vercel.app)
SITE_URL=

# Google Ads API (nível da agência). Veja a página Conexões, Partes A e B.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Windsor.ai (provedor TEMPORÁRIO de anúncios, só servidor; sai quando a leitura nativa entrar)
WINDSOR_API_KEY=

# Segredo do cron (Vercel envia como "Authorization: Bearer"). Frase longa aleatória.
CRON_SECRET=
# Opcional: para testar a sincronização na mão com o cabeçalho x-cron-secret.
TRAFEGO_CRON_SECRET=
